      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "arena-mysql"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT e.created_at AS time, e.analysis_id, e.session_id, e.retrieved_count, e.duration_ms, GROUP_CONCAT(CONCAT(h.rank_no, '. ', COALESCE(h.title, h.document_id), ' [', COALESCE(h.collection, ''), ']') ORDER BY h.rank_no SEPARATOR '\\n') AS hits FROM arena_rag_retrieval_events e LEFT JOIN arena_rag_retrieval_hits h ON h.event_id = e.event_id WHERE $__timeFilter(e.created_at) GROUP BY e.event_id, e.created_at, e.analysis_id, e.session_id, e.retrieved_count, e.duration_ms ORDER BY e.created_at DESC LIMIT 50",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Recent RAG Retrievals",
      "type": "table"
