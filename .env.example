DASHSCOPE_API_KEY=your_api_key_here
SPRING_PROFILES_ACTIVE=redis

# Apple Silicon runs OCR most reliably with the native Linux arm64 Paddle wheel.
OCR_PLATFORM=linux/arm64

OCR_WORKER_MAX_RETRIES=2
OCR_WORKER_RETRY_DELAY_SECONDS=2

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Keep Redis for app state while writing RAG audit events to MySQL.
ARENA_MYSQL_ENABLED=true

# Token bucket for POST /api/arena/analyze/async.
ARENA_RATE_LIMIT_ANALYZE_ENABLED=true
ARENA_RATE_LIMIT_ANALYZE_PER_SESSION_CAPACITY=10
ARENA_RATE_LIMIT_ANALYZE_PER_SESSION_REFILL_TOKENS=10
ARENA_RATE_LIMIT_ANALYZE_PER_SESSION_REFILL_PERIOD=PT1M
ARENA_RATE_LIMIT_ANALYZE_PER_IP_CAPACITY=30
ARENA_RATE_LIMIT_ANALYZE_PER_IP_REFILL_TOKENS=30
ARENA_RATE_LIMIT_ANALYZE_PER_IP_REFILL_PERIOD=PT1M
